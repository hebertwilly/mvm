---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo-mvm-ajustada.png';
const { compact = false } = Astro.props;
---

<a class:list={['brand', { 'brand--compact': compact }]} href="/">
  <Image src={logo} alt="MVM Segurança e Medicina Ocupacional" width={compact ? 190 : 160} loading="eager" decoding="async" />
</a>
