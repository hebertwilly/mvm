---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { contact } from '../config/contact.js';
const { photos = [] } = Astro.props;
---
<section class="section about-gallery" aria-labelledby="about-gallery-title">
  <div class="container">
    <span class="reference-kicker">ROTINA DA MVM</span>
    <div class="about-gallery-heading">
      <div>
        <h2 id="about-gallery-title" class="section-title" data-motion="reveal">Acompanhe a MVM de perto</h2>
        <p data-motion="reveal">Conheça as pessoas e os momentos que fazem parte da nossa rotina de cuidado, prevenção e parceria com as empresas.</p>
      </div>
      <a class="button button--dark" href={contact.instagram.url} target="_blank" rel="noopener noreferrer"><Icon name="instagram" />Acompanhe {contact.instagram.handle}</a>
    </div>
    <div class="about-mosaic">
      {photos.map(({ src, alt }, index) => <figure class:list={['about-mosaic-item', `about-mosaic-item--${index + 1}`]} data-motion="card">
        <Image src={src} alt={alt} widths={[320, 520, 760]} sizes="(max-width: 52rem) 45vw, 280px" loading="lazy" decoding="async" />
      </figure>)}
    </div>
  </div>
</section>

<style>
  .about-gallery-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 28px; }
  .about-gallery-heading > div { max-width: 690px; }
  .about-gallery-heading .section-title { margin-bottom: 14px; }
  .about-gallery-heading .section-title::before { display: none; }
  .about-gallery-heading .button { flex: none; }
  .about-gallery-heading .button svg { width: 22px; height: 22px; }
  .about-mosaic { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-template-rows: repeat(2, 230px); gap: var(--grid-gap); }
  .about-mosaic-item { min-width: 0; min-height: 0; overflow: hidden; border-radius: 14px; background: #f1f1f1; transition: box-shadow 220ms ease, translate 220ms ease; }
  .about-mosaic-item:nth-child(-n+3) { grid-row: span 2; }
  .about-mosaic-item img { width: 100%; height: 100%; object-fit: contain; }
  @media (hover: hover) and (pointer: fine) { .about-mosaic-item:hover { translate: 0 -3px; box-shadow: 0 8px 20px rgb(20 20 20 / 9%); } }
  @media (max-width: 52rem) {
    .about-gallery-heading { align-items: flex-start; flex-direction: column; }
    .about-mosaic { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: none; }
    .about-mosaic-item:nth-child(-n+3) { grid-row: auto; }
    .about-mosaic-item { aspect-ratio: 3 / 4; }
    .about-mosaic-item:nth-child(n+4) { aspect-ratio: 4 / 3; }
  }
  @media (prefers-reduced-motion: reduce) { .about-mosaic-item { transition: none; } }
</style>
